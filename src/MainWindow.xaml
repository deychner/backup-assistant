<Window x:Class="BackupAssistant.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:BackupAssistant.ViewModels"
        mc:Ignorable="d"
        Title="Backup Assistant" Icon="/assets/icon.ico"
        WindowStartupLocation="CenterScreen"
        SizeToContent="Height" Width="500"
        ResizeMode="CanResize">
    <Window.DataContext>
        <viewmodels:MainWindowViewModel/>
    </Window.DataContext>
    <Window.Resources>
        <Style TargetType="{x:Type Button}">
            <Setter Property="Margin" Value="5"/>
        </Style>
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Margin" Value="5"/>
        </Style>
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Margin" Value="5"/>
        </Style>
        <Style TargetType="{x:Type GroupBox}">
            <Setter Property="Margin" Value="5"/>
        </Style>
        <Style TargetType="{x:Type Label}">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <StackPanel>
        <DockPanel Grid.Column="0" Grid.Row="0">
            <Menu DockPanel.Dock="Top">
                <MenuItem Header="File">
                    <MenuItem Header="Exit" />
                </MenuItem>
                <MenuItem Header="Help">
                    <MenuItem Header="About" />
                </MenuItem>
            </Menu>
        </DockPanel>

        <GroupBox Header="Backup">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Label Content="Source:" Grid.Column="0" Grid.Row="0" />
                <Label Content="Destination:" Grid.Column="0" Grid.Row="1" />
                <Label Content="Type:" Grid.Column="0" Grid.Row="2" />

                <TextBox IsEnabled="False"
                         Grid.Column="1" Grid.Row="0" Grid.ColumnSpan="3"/>
                <TextBox IsEnabled="False"
                         Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="3" />
                <ComboBox Grid.Column="1" Grid.Row="2" Grid.ColumnSpan="3">
                    <ComboBoxItem>Incremental</ComboBoxItem>
                    <ComboBoxItem>Full</ComboBoxItem>
                </ComboBox>

                <Button Grid.Column="4" Grid.Row="0"
                        Height="23" Width="23">
                    <Image Source="/assets/view.png" Stretch="None"/>
                </Button>
                <Button Grid.Column="4" Grid.Row="1"
                        Height="23" Width="23">
                    <Image Source="/assets/view.png" Stretch="None"/>
                </Button>
                <Button x:Name="Button_Filter"
                        Grid.Column="5" Grid.Row="0" Grid.RowSpan="2"
                        Width="23">
                    <Image Source="{Binding FilterImageSource}" Stretch="None"/>
                </Button>

                <Button Content="Backup" Grid.Column="2" Grid.Row="3" />
                <Button Content="Cancel" Grid.Column="3" Grid.Row="3" />
            </Grid>
        </GroupBox>

        <StatusBar>
            <StatusBarItem>
                <Label Content="Progress:"/>
            </StatusBarItem>
            <StatusBarItem>
                <ProgressBar Height="10" Width="150"/>
            </StatusBarItem>
            <StatusBarItem>
                <Label Content="Current"/>
            </StatusBarItem>
        </StatusBar>
    </StackPanel>
</Window>
