<Window x:Class="BackupAssistant.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:datamodels="clr-namespace:BackupAssistant.DataModels"
        xmlns:extensions="clr-namespace:BackupAssistant.Extensions"
        xmlns:viewmodels="clr-namespace:BackupAssistant.ViewModels"
        d:DataContext="{d:DesignInstance Type=viewmodels:MainWindowViewModel}"
        mc:Ignorable="d"
        Title="Backup Assistant" Icon="/assets/icon.ico"
        WindowStartupLocation="CenterScreen"
        SizeToContent="Height" Width="500"
        ResizeMode="CanResize">
    <Window.Background>
        <SolidColorBrush Color="WhiteSmoke"/>
    </Window.Background>
    <StackPanel>
        <DockPanel Grid.Column="0" Grid.Row="0">
            <Menu DockPanel.Dock="Top">
                <MenuItem Header="File">
                    <MenuItem Header="Exit" Command="{Binding ExitCommand}">
                        <MenuItem.Icon>
                            <Image Source="/assets/arrow_exit_20_regular.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="Help">
                    <MenuItem Header="About" Command="{Binding AboutCommand}">
                        <MenuItem.Icon>
                            <Image Source="/assets/question_circle_16_regular.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
            </Menu>
        </DockPanel>

        <GroupBox Header="Backup">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Label Content="Source:" Grid.Column="0" Grid.Row="0" />
                <Label Content="Destination:" Grid.Column="0" Grid.Row="1" />
                <Label Content="Type:" Grid.Column="0" Grid.Row="2" />

                <TextBox IsEnabled="False" Text="{Binding Source}"
                         Grid.Column="1" Grid.Row="0" Grid.ColumnSpan="3"/>
                <TextBox IsEnabled="False" Text="{Binding Destination}"
                         Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="3" />
                <ComboBox Grid.Column="1" Grid.Row="2" Grid.ColumnSpan="3"
                          SelectedValue="{Binding BackupType}"
                          ItemsSource="{extensions:EnumCollection EnumType=datamodels:BackupType}" />

                <Button Grid.Column="4" Grid.Row="0"
                        Command="{Binding AddEditSourceCommand}"
                        Height="25" Width="25">
                    <Image Source="/assets/search_16_regular.png" Stretch="None"/>
                </Button>
                <Button Grid.Column="4" Grid.Row="1"
                        Command="{Binding AddEditDestinationCommand}"
                        Height="25" Width="25">
                    <Image Source="/assets/search_16_regular.png" Stretch="None"/>
                </Button>
                <Button Grid.Column="5" Grid.Row="0" Grid.RowSpan="2"
                        Command="{Binding EditFiltersCommand}" Width="25"
                        ToolTip="Choose folders to back up">
                    <Image Source="{Binding FilterImageSource}" Stretch="None"/>
                </Button>

                <Button Grid.Column="2" Grid.Row="3"
                        Content="Backup" Command="{Binding RunBackupCommand}" />
                <Button Grid.Column="3" Grid.Row="3"
                        Content="Cancel" Command="{Binding CancelRunBackupCommand}"/>
            </Grid>
        </GroupBox>

        <StatusBar>
            <StatusBarItem>
                <Label Content="Progress:"/>
            </StatusBarItem>
            <StatusBarItem>
                <ProgressBar Height="10" Width="150" Minimum="0" Maximum="100"
                             Value="{Binding Progress}" IsIndeterminate="{Binding ProgressBarIsIndeterminate}" />
            </StatusBarItem>
            <StatusBarItem>
                <Label Content="{Binding Status}"/>
            </StatusBarItem>
        </StatusBar>
    </StackPanel>
</Window>
