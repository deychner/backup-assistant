<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="BackupAssistant.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:datamodels="using:BackupAssistant.DataModels"
    xmlns:extensions="using:BackupAssistant.Extensions"
    xmlns:viewmodels="using:BackupAssistant.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:MainWindowViewModel}"
    mc:Ignorable="d"
    Title="Backup Assistant"
    Width="800"
    Height="600">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Menu Bar -->
        <MenuBar Grid.Row="0">
            <MenuFlyoutItem Text="File">
                <MenuFlyoutSubItem Text="File">
                    <MenuFlyoutItem Text="Exit" Command="{Binding ExitCommand}"/>
                </MenuFlyoutSubItem>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Help">
                <MenuFlyoutSubItem Text="Help">
                    <MenuFlyoutItem Text="About" Command="{Binding AboutCommand}"/>
                </MenuFlyoutSubItem>
            </MenuFlyoutItem>
        </MenuBar>

        <!-- Main Content with SplitView for Filters Pane -->
        <SplitView Grid.Row="1"
                   IsPaneOpen="{Binding IsFiltersPaneOpen, Mode=TwoWay}"
                   OpenPaneLength="300"
                   PanePlacement="Right"
                   DisplayMode="Inline">

            <!-- Main Content -->
            <SplitView.Content>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="20" Spacing="12">
                        <!-- Backup Section -->
                        <TextBlock Text="Backup" 
                                   FontSize="20" 
                                   FontWeight="Medium"/>

                        <Grid ColumnSpacing="12" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Source -->
                            <TextBlock Grid.Column="0" Grid.Row="0"
                                       Text="Source:"
                                       VerticalAlignment="Center"
                                       FontWeight="Medium"/>
                            <TextBox Grid.Column="1" Grid.Row="0"
                                     Text="{Binding Source, Mode=TwoWay}"
                                     IsReadOnly="True"
                                     PlaceholderText="No folder selected"/>
                            <Button Grid.Column="2" Grid.Row="0"
                                    Command="{Binding AddEditSourceCommand}"
                                    ToolTipService.ToolTip="Browse for source folder">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE721;"/>
                            </Button>

                            <!-- Destination -->
                            <TextBlock Grid.Column="0" Grid.Row="1"
                                       Text="Destination:"
                                       VerticalAlignment="Center"
                                       FontWeight="Medium"/>
                            <TextBox Grid.Column="1" Grid.Row="1"
                                     Text="{Binding Destination, Mode=TwoWay}"
                                     IsReadOnly="True"
                                     PlaceholderText="No folder selected"/>
                            <Button Grid.Column="2" Grid.Row="1"
                                    Command="{Binding AddEditDestinationCommand}"
                                    ToolTipService.ToolTip="Browse for destination folder">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE721;"/>
                            </Button>

                            <!-- Backup Type -->
                            <TextBlock Grid.Column="0" Grid.Row="2"
                                       Text="Type:"
                                       VerticalAlignment="Center"
                                       FontWeight="Medium"/>
                            <ComboBox Grid.Column="1" Grid.Row="2" Grid.ColumnSpan="2"
                                      SelectedValue="{Binding BackupType, Mode=TwoWay}"
                                      ItemsSource="{extensions:EnumCollection EnumType=datamodels:BackupType}"/>

                            <!-- Filters Button -->
                            <TextBlock Grid.Column="0" Grid.Row="3"
                                       Text="Filters:"
                                       VerticalAlignment="Center"
                                       FontWeight="Medium"/>
                            <Button Grid.Column="1" Grid.Row="3"
                                    Command="{Binding EditFiltersCommand}"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource AccentButtonBackground}"
                                    Foreground="{ThemeResource AccentButtonForeground}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" 
                                              Glyph="{Binding FilterIconGlyph}"/>
                                    <TextBlock Text="{Binding FilterCountText}"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Action Buttons -->
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,20,0,0">
                            <Button Content="Backup"
                                    Command="{Binding RunBackupCommand}"
                                    Padding="32,8"
                                    Background="{ThemeResource AccentButtonBackground}"
                                    Foreground="{ThemeResource AccentButtonForeground}"/>
                            <Button Content="Cancel"
                                    Command="{Binding CancelRunBackupCommand}"
                                    Padding="32,8"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </SplitView.Content>

            <!-- Filters Pane -->
            <SplitView.Pane>
                <Grid Padding="12" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Pane Header -->
                    <StackPanel Grid.Row="0" Spacing="8">
                        <TextBlock Text="Filter Folders"
                                   FontSize="16"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Select folders to exclude from backup:"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Filter List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsView ItemsSource="{Binding FilterItemsForPane}">
                            <ItemsView.ItemTemplate>
                                <DataTemplate x:DataType="datamodels:FilterItem">
                                    <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,8">
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"/>
                                        <TextBlock Text="{Binding Path}"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsView.ItemTemplate>
                        </ItemsView>
                    </ScrollViewer>

                    <!-- Pane Footer with Apply/Close -->
                    <StackPanel Grid.Row="2" Spacing="8" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Close"
                                Command="{Binding CloseFiltersPaneCommand}"/>
                    </StackPanel>
                </Grid>
            </SplitView.Pane>
        </SplitView>

        <!-- Status Bar -->
        <Grid Grid.Row="2" 
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,1,0,0"
              Padding="12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Progress:"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <ProgressBar Grid.Column="1"
                         Margin="12,0,12,0"
                         Minimum="0"
                         Maximum="100"
                         Value="{Binding Progress, Mode=OneWay}"
                         IsIndeterminate="{Binding ProgressBarIsIndeterminate, Mode=OneWay}"/>
            <TextBlock Grid.Column="2"
                       Text="{Binding Status, Mode=OneWay}"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextTrimming="CharacterEllipsis"/>
        </Grid>
    </Grid>
</Window>
