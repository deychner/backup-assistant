<Window x:Class="BackupAssistant.About"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="About"
        WindowStartupLocation="CenterScreen"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize" Icon="/assets/icon.ico">
    <Window.Background>
        <SolidColorBrush Color="WhiteSmoke"/>
    </Window.Background>
    <Window.Resources>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="20,10,20,10"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <StackPanel>
        <TextBlock Text="Backup Assistant" FontSize="24"/>
        <TextBlock Text="{Binding ApplicationVersion}" FontSize="12"/>
        <Button Content="OK" Click="OK_Click" Width="85"/>
    </StackPanel>
</Window>
