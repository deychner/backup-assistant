<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyVersion>2023.7.18.1</AssemblyVersion>
    <StartupObject>BackupAssistant.App</StartupObject>
    <ApplicationIcon>assets\icon.ico</ApplicationIcon>
    <Authors>Darryl Eychner</Authors>
    <Company>Anaheim Electronics</Company>
    <Copyright>Copyright © Darryl Eychner 2023</Copyright>
    <FileVersion>2023.7.18.1</FileVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <NoWarn>1701;1702;WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="assets\filter.png" />
    <None Remove="assets\filter_apply.png" />
    <None Remove="assets\help.png" />
    <None Remove="assets\icon.ico" />
    <None Remove="assets\view.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="assets\icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="7.0.0" />
    <PackageReference Include="System.IO.Abstractions" Version="19.2.29" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="assets\filter.png" />
    <Resource Include="assets\filter_apply.png" />
    <Resource Include="assets\help.png" />
    <Resource Include="assets\icon.ico" />
    <Resource Include="assets\view.png" />
  </ItemGroup>

</Project>
