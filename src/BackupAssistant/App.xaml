<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="BackupAssistant.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        No RequestedTheme is set anywhere in this application. That is deliberate: leaving it
        unset makes WinUI follow the Windows "Choose your mode" app theme setting, and re-resolve
        every ThemeResource live when the user switches between light and dark.
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

</Application>
