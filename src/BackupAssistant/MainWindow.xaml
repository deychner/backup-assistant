<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="BackupAssistant.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Backup Assistant">

    <!-- Mica tints itself from the desktop wallpaper and tracks the light/dark app theme. -->
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <MenuBar Grid.Row="0">
            <MenuBarItem Title="File">
                <MenuFlyoutItem Text="Exit" Command="{x:Bind ViewModel.ExitCommand}">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE8BB;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuBarItem>
            <MenuBarItem Title="Help">
                <MenuFlyoutItem Text="About" Command="{x:Bind ViewModel.AboutCommand}">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuBarItem>
        </MenuBar>

        <ScrollViewer Grid.Row="1" Padding="24,8,24,16">
            <StackPanel Spacing="12">

                <TextBlock Text="Backup" Style="{StaticResource SubtitleTextBlockStyle}" />

                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                    <Grid ColumnSpacing="12" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0" Grid.Column="0"
                            Text="Source" VerticalAlignment="Center" />
                        <TextBox
                            Grid.Row="0" Grid.Column="1"
                            IsReadOnly="True"
                            PlaceholderText="Choose the folder to back up"
                            Text="{x:Bind ViewModel.Source, Mode=OneWay}" />
                        <Button
                            Grid.Row="0" Grid.Column="2"
                            AutomationProperties.Name="Browse for the source folder"
                            Command="{x:Bind ViewModel.AddEditSourceCommand}"
                            ToolTipService.ToolTip="Browse for the source folder">
                            <FontIcon Glyph="&#xE8B7;" FontSize="16" />
                        </Button>

                        <TextBlock
                            Grid.Row="1" Grid.Column="0"
                            Text="Destination" VerticalAlignment="Center" />
                        <TextBox
                            Grid.Row="1" Grid.Column="1"
                            IsReadOnly="True"
                            PlaceholderText="Choose where to put the backup"
                            Text="{x:Bind ViewModel.Destination, Mode=OneWay}" />
                        <Button
                            Grid.Row="1" Grid.Column="2"
                            AutomationProperties.Name="Browse for the destination folder"
                            Command="{x:Bind ViewModel.AddEditDestinationCommand}"
                            ToolTipService.ToolTip="Browse for the destination folder">
                            <FontIcon Glyph="&#xE8B7;" FontSize="16" />
                        </Button>

                        <TextBlock
                            Grid.Row="2" Grid.Column="0"
                            Text="Type" VerticalAlignment="Center" />
                        <ComboBox
                            Grid.Row="2" Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            ItemsSource="{x:Bind ViewModel.BackupTypes}"
                            SelectedItem="{x:Bind ViewModel.BackupType, Mode=TwoWay}" />

                        <TextBlock
                            Grid.Row="3" Grid.Column="0"
                            Text="Folders" VerticalAlignment="Center" />
                        <TextBlock
                            Grid.Row="3" Grid.Column="1"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.FilterSummary, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <Button
                            Grid.Row="3" Grid.Column="2"
                            AutomationProperties.Name="Choose which folders to back up"
                            Command="{x:Bind ViewModel.EditFiltersCommand}"
                            ToolTipService.ToolTip="Choose which folders to back up">
                            <FontIcon Glyph="&#xE71C;" FontSize="16" />
                        </Button>
                    </Grid>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button
                        Content="Cancel"
                        MinWidth="100"
                        Command="{x:Bind ViewModel.CancelRunBackupCommand}" />
                    <Button
                        Content="Back up"
                        MinWidth="100"
                        Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.RunBackupCommand}" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <Border
            Grid.Row="2"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            Padding="24,10">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ProgressBar
                    Grid.Column="0"
                    Width="160"
                    VerticalAlignment="Center"
                    Minimum="0" Maximum="100"
                    IsIndeterminate="{x:Bind ViewModel.ProgressBarIsIndeterminate, Mode=OneWay}"
                    Value="{x:Bind ViewModel.Progress, Mode=OneWay}" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

    </Grid>
</Window>
