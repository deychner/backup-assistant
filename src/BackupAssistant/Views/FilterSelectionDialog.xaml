<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="BackupAssistant.Views.FilterSelectionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:datamodels="using:BackupAssistant.DataModels"
    mc:Ignorable="d"
    Title="Choose folders"
    PrimaryButtonText="Apply"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <StackPanel Spacing="8" Width="400">
        <TextBlock
            Style="{StaticResource CaptionTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="Check the subfolders you want to back up. Files sitting directly in the source folder are always included. Leave everything unchecked to back up the whole source folder."
            TextWrapping="Wrap" />

        <ListView
            Height="300"
            SelectionMode="None"
            ItemsSource="{x:Bind ViewModel.FilterItems, Mode=OneWay}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="datamodels:FilterItem">
                    <CheckBox
                        Content="{x:Bind Path}"
                        IsChecked="{x:Bind IsChecked, Mode=TwoWay}" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackPanel>

</ContentDialog>
